import math
import hashlib
import json
import random
import numpy as np
from datetime import datetime
from collections import deque
from typing import Dict, Tuple, List, Optional

# --------------------------------------------------------------------------
# LAYER 1: PATTERN ENGINES & SENSOR NORMALIZATION
# --------------------------------------------------------------------------
class PatternEngine:
    @staticmethod
    def normalize(val: float, min_v: float, max_v: float) -> float:
        """Ensures biologically realistic magnitudes (0-1 range)."""
        if max_v == min_v: return 0.5
        return max(0.0, min(1.0, (val - min_v) / (max_v - min_v)))

# --------------------------------------------------------------------------
# LAYER 2: COGNITIVE GOVERNANCE (HARDENED SE44 & FOSSILIZATION)
# --------------------------------------------------------------------------
class SE44StabilityGate:
    def __init__(self):
        # Strict OPHI Standards
        self.min_coherence = 0.985
        self.max_entropy = 0.01
        self.max_rms_drift = 0.001

    def evaluate(self, entropy: float, rms_drift: float) -> Tuple[bool, Dict]:
        """Patch: Enforces consistent drift clamping for threshold checks."""
        # Clamp drift to before computing coherence and comparing to thresholds
        clamped_drift = max(0.0, min(1.0, rms_drift))
        coherence = 1.0 - clamped_drift  # Dynamic coherence calculation
        
        metrics = {
            "coherence": coherence,
            "entropy": entropy,
            "rms_drift": rms_drift,
            "timestamp": datetime.utcnow().isoformat() + "Z"
        }
        
        # Consistent application of SE44 thresholds
        is_stable = (coherence >= self.min_coherence and 
                     entropy <= self.max_entropy and 
                     clamped_drift <= self.max_rms_drift)
        
        metrics["passed"] = is_stable
        metrics["thresholds"] = {
            "coherence_min": self.min_coherence,
            "entropy_max": self.max_entropy,
            "rms_drift_max": self.max_rms_drift
        }
        return is_stable, metrics

class FossilLedger:
    def __init__(self):
        self.chain: List[Dict] = []
        self.last_hash = "GENESIS"

    def commit(self, state: float, bias: float, alpha: float, metrics: Dict) -> Dict:
        """Creates an immutable memory record via SHA-256 chaining."""
        record = {
            "timestamp": metrics["timestamp"],
            "state": f"{state:.6f}",
            "bias": f"{bias:.6f}",
            "alpha": f"{alpha:.6f}",
            "metrics": metrics,
            "hash_prev": self.last_hash
        }
        # Canonical serialization
        record_str = json.dumps(record, sort_keys=True, separators=(",", ":"))
        record["hash_current"] = hashlib.sha256(record_str.encode()).hexdigest()
        self.last_hash = record["hash_current"]
        self.chain.append(record)
        return record

    def validate_chain(self) -> Tuple[bool, str]:
        """Ensures cryptographic continuity of the memory ledger."""
        for i in range(1, len(self.chain)):
            if self.chain[i]["hash_prev"] != self.chain[i-1]["hash_current"]:
                return False, f"Chain broken at tick {i}"
        return True, "Chain Valid"

# --------------------------------------------------------------------------
# LAYER 3: ADAPTIVE LEARNING LOOP (HARDENED DRIFT ENGINE)
# --------------------------------------------------------------------------
class LearningEngine:
    def __init__(self):
        self.entropy_accumulator = 0.0
        self.damping_factor = 4.2 # Sharpness constant k

    def compute_effective_drift(self, raw_drift: float, curiosity: float = 0.0) -> float:
        """Patch: Bounded adaptation engine ensuring result ∈."""
        # Entropy modulates learning sensitivity (higher entropy = lower sensitivity)
        sensitivity = 1.0 / (1.0 + max(0.0, self.entropy_accumulator))
        
        # Sigmoid damping function prevents hyper-reactivity
        scaled_drift = raw_drift * sensitivity
        effective = 1.0 - math.exp(-self.damping_factor * scaled_drift)
        
        # Curiosity modulation (bounded to prevent runaway feedback)
        curiosity_mod = 1.0 + min(1.0, curiosity * 0.3)
        result = effective * curiosity_mod
        
        # Cap to to guarantee monotonic bounded update magnitude
        return max(0.0, min(1.0, result))

# --------------------------------------------------------------------------
# LAYER 4: AGENCY & PSI TRANSFERENCE
# --------------------------------------------------------------------------
class IntentGovernor:
    def __init__(self, min_cycles: int = 10):
        self.current_intent = "observe_environment"
        self.intent_age = 0
        self.min_cycles = min_cycles

    def propose_shift(self, drift: float, entropy: float) -> bool:
        """Constraints goal formation to prevent chaotic agency."""
        self.intent_age += 1
        # Intent only mutates under stable cognition
        if self.intent_age > self.min_cycles and drift < 0.001 and entropy < 0.01:
            self.current_intent = "refine_prediction"
            return True
        return False

# --------------------------------------------------------------------------
# TEST FRAMEWORK: INTEGRATED VALIDATION
# --------------------------------------------------------------------------
class OPHITestFramework:
    def __init__(self):
        self.test_results = {}

    def run_integrated_test(self, ticks: int = 20):
        """Patch: Validates the irreducible loop and records explicit results."""
        ledger = FossilLedger()
        gate = SE44StabilityGate()
        engine = LearningEngine()
        governor = IntentGovernor()
        
        state, bias, alpha = 0.5, 0.1, 1.0
        drift_history = deque(maxlen=10)
        learning_events = 0

        for tick in range(ticks):
            # Experience (L1)
            percept = PatternEngine.normalize(random.uniform(200, 800), 0, 1000)
            
            # Error (L3)
            prediction = (state + bias) * alpha # Core Ω formula
            raw_drift = abs(prediction - percept)
            drift_history.append(raw_drift)
            rms_drift = math.sqrt(sum(d*d for d in drift_history)/len(drift_history))
            
            # Adaptation (L3)
            eff_drift = engine.compute_effective_drift(raw_drift)
            if raw_drift > 0.01:
                bias += eff_drift * 0.1
                state += eff_drift * 0.05
                engine.entropy_accumulator += raw_drift * 0.02
                learning_events += 1
            
            # Healing
            engine.entropy_accumulator = max(0.0, engine.entropy_accumulator - 0.01)
            
            # Governance (L2)
            passed, metrics = gate.evaluate(engine.entropy_accumulator, rms_drift)
            if passed:
                ledger.commit(state, bias, alpha, metrics)
            
            # Agency (L4)
            governor.propose_shift(rms_drift, engine.entropy_accumulator)

        # Final validation
        valid, message = ledger.validate_chain()
        
        # Record integrated test result explicitly
        integrated_pass = valid and learning_events >= 0
        self.test_results["integrated"] = "PASS" if integrated_pass else "FAIL"
        self.test_results["chain_integrity"] = "PASS" if valid else "FAIL"
        
        return all(result == "PASS" for result in self.test_results.values()), message

# Execute Hardened Test
if __name__ == "__main__":
    tester = OPHITestFramework()
    success, msg = tester.run_integrated_test()
    print(f"Test Status: {'SUCCESS' if success else 'FAILURE'}")
    print(f"Test Results: {tester.test_results}")
    print(f"Message: {msg}")
