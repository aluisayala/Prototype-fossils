class RealTransformationController:
    """
    Production-grade controller with execution-backed validation.
    """
    
    def __init__(self, 
                 scanner: 'SystemScanner',
                 oracle: BehaviorLock,
                 classifier: 'StabilityClassifier',
                 moves: 'MoveLibrary'):
        
        self.scanner = scanner
        self.oracle = oracle
        self.classifier = classifier
        self.moves = moves
        self.engine = oracle.engine
        
        # Control parameters (tuned for safety)
        self.safety_threshold = 0.95
        self.improvement_threshold = 0.01
        self.risk_threshold = 0.7
        
        self.history: List[Dict] = []
        
    def execute_real_transformation(self, target_id: str, 
                                    move_name: str) -> Dict[str, Any]:
        """
        Execute single transformation with full validation pipeline.
        """
        print(f"\n{'='*60}")
        print(f"EXECUTING: {move_name} on {target_id}")
        print(f"{'='*60}")
        
        result = {
            'target': target_id,
            'move': move_name,
            'success': False,
            'phases': {}
        }
        
        # Phase 1: Pre-flight checks
        print("[1] PRE-FLIGHT CHECKS")
        stability = self.classifier.calculate_stability(target_id)
        print(f"    Risk score: {stability['risk_score']:.3f} ({stability['classification']})")
        
        if stability['risk_score'] > self.risk_threshold:
            result['phases']['preflight'] = {'passed': False, 'reason': 'Risk too high'}
            print("    ✗ ABORTED: Risk threshold exceeded")
            return result
        
        result['phases']['preflight'] = {'passed': True}
        
        # Phase 2: Get original function
        print("[2] LOADING ORIGINAL FUNCTION")
        original_ast = self.scanner.functions.get(target_id)
        if not original_ast:
            result['phases']['load'] = {'passed': False, 'reason': 'Function not found'}
            print("    ✗ ABORTED: Target not in registry")
            return result
        
        # Compile original for baseline
        try:
            original_func = self.engine.ast_to_function(
                original_ast,
                global_env=self._build_global_env()
            )
            print(f"    ✓ Compiled: {original_ast.name}")
        except Exception as e:
            result['phases']['load'] = {'passed': False, 'reason': str(e)}
            print(f"    ✗ COMPILATION FAILED: {e}")
            return result
        
        result['phases']['load'] = {'passed': True}
        
        # Phase 3: Apply transformation
        print("[3] APPLYING TRANSFORMATION")
        move = self.moves.get_move(move_name)
        if not move:
            result['phases']['transform'] = {'passed': False, 'reason': 'Move not found'}
            print("    ✗ ABORTED: Unknown move")
            return result
        
        context = {
            'target_id': target_id,
            'scanner': self.scanner,
            'global_env': self._build_global_env()
        }
        
        try:
            new_ast, metadata, exec_success = move.apply(original_ast, context)
            if not exec_success:
                raise RuntimeError(metadata.get('error', 'Unknown transformation error'))
            print(f"    ✓ Transformation applied: {metadata}")
        except Exception as e:
            result['phases']['transform'] = {'passed': False, 'reason': str(e)}
            print(f"    ✗ TRANSFORMATION FAILED: {e}")
            return result
        
        result['phases']['transform'] = {'passed': True, 'metadata': metadata}
        
        # Phase 4: VALIDATION (The critical feedback loop)
        print("[4] VALIDATION (Execution-Backed)")
        print("    Compiling transformed AST...")
        print("    Executing against oracle test suite...")
        
        verification = self.oracle.verify_transformation(
            target_id,
            original_func,
            new_ast,
            global_env=self._build_global_env()
        )
        
        result['phases']['validation'] = verification
        
        if not verification['verified']:
            print(f"    ✗ VALIDATION FAILED")
            print(f"      Confidence: {verification['confidence']:.3f}")
            print(f"      Passed: {verification['passed']}/{verification['test_cases']}")
            
            if verification['mismatches']:
                print(f"      Mismatches:")
                for m in verification['mismatches'][:3]:
                    print(f"        - {m['type']}: {m.get('case', 'unknown')}")
            
            # Rollback is automatic since we never committed
            print("    → ROLLBACK: Retaining original")
            return result
        
        print(f"    ✓ VALIDATION PASSED")
        print(f"      Confidence: {verification['confidence']:.3f}")
        print(f"      All {verification['test_cases']} test cases passed")
        
        if verification['execution_times']:
            orig_avg = sum(verification['execution_times']['original']) / len(verification['execution_times']['original'])
            trans_avg = sum(verification['execution_times']['transformed']) / len(verification['execution_times']['transformed'])
            perf_delta = ((trans_avg - orig_avg) / orig_avg) * 100
            print(f"      Performance: {perf_delta:+.1f}% vs original")
        
        # Phase 5: Commit
        print("[5] COMMITTING TRANSFORMATION")
        self.scanner.functions[target_id] = new_ast
        self.classifier.record_change(target_id, success=True)
        
        result['success'] = True
        result['new_ast'] = new_ast
        result['transformed_func'] = verification['transformed_func']
        
        print("    ✓ COMMITTED to codebase")
        
        return result
    
    def _build_global_env(self) -> Dict[str, Any]:
        """Build execution environment with common dependencies."""
        return {
            'math': __import__('math'),
            'random': __import__('random'),
            'json': __import__('json'),
            'time': __import__('time'),
            'len': len, 'range': range, 'enumerate': enumerate,
            'zip': zip, 'map': map, 'filter': filter,
            'sum': sum, 'min': min, 'max': max, 'abs': abs,
            'str': str, 'int': int, 'float': float, 'bool': bool,
            'list': list, 'dict': dict, 'set': set, 'tuple': tuple,
        }
    
    def run_autonomous_session(self, max_transforms: int = 5) -> Dict[str, Any]:
        """
        Run closed-loop control with real execution validation.
        """
        print("""
╔══════════════════════════════════════════════════════════════════╗
║     LEGACY BOX v2 - Execution-Backed Autonomous Control          ║
║                                                                  ║
║  Validation: REAL (AST → Compile → Execute → Compare)            ║
╚══════════════════════════════════════════════════════════════════╝
""")
        
        session = {
            'transforms_attempted': 0,
            'transforms_successful': 0,
            'transforms_failed': [],
            'final_state': {}
        }
        
        for i in range(max_transforms):
            print(f"\n{'#'*60}")
