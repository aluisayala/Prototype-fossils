            else:
                session['transforms_failed'].append({
                    'target': target_id,
                    'move': move_name,
                    'failed_phase': self._get_failed_phase(result),
                    'reason': self._get_failure_reason(result)
                })
                print(f"\n✗ FAILED: {self._get_failure_reason(result)}")
        
        session['final_state'] = {
            'functions': len(self.scanner.functions),
            'potential': self._estimate_potential()
        }
        
        self._print_session_summary(session)
        return session
    
    def _rank_candidates(self) -> List[Tuple[str, str, float]]:
        """Rank all possible transformations by safety-weighted improvement."""
        candidates = []
        
        for func_id, func_ast in self.scanner.functions.items():
            stability = self.classifier.calculate_stability(func_id)
            if stability['risk_score'] > self.risk_threshold:
                continue
            
            # Find applicable moves
            for move_name, move in self.moves.moves.items():
                if move.can_apply(func_ast):
                    # Estimate improvement (simplified)
                    improvement = self._estimate_improvement(func_id, move_name)
                    safety = 1.0 - stability['risk_score']
                    score = (0.4 * safety) + (0.6 * max(0, improvement))
                    
                    candidates.append((func_id, move_name, score))
        
        candidates.sort(key=lambda x: x[2], reverse=True)
        return candidates
    
    def _estimate_improvement(self, func_id: str, move_name: str) -> float:
        """Estimate structural improvement from move."""
        # Simplified heuristics
        if move_name == 'EXTRACT_FUNCTION':
            func_ast = self.scanner.functions[func_id]
            complexity = self.scanner._calc_complexity(func_ast)
            return 0.1 * (complexity / 10)  # Higher complexity = more improvement
        elif move_name == 'ISOLATE_PURE_CORE':
            return 0.15  # Good for testability
        elif move_name == 'INLINE_REDUNDANT':
            return 0.05  # Minor cleanup
        return 0.01
    
    def _estimate_potential(self) -> float:
        """Estimate current structural potential."""
        # Simplified metric
        total_complexity = sum(
            self.scanner._calc_complexity(f) 
            for f in self.scanner.functions.values()
        )
        return total_complexity / max(1, len(self.scanner.functions))
    
    def _get_failed_phase(self, result: Dict) -> str:
        for phase, data in result.get('phases', {}).items():
            if not data.get('passed', True):
                return phase
        return 'unknown'
    
    def _get_failure_reason(self, result: Dict) -> str:
        phase = self._get_failed_phase(result)
        phase_data = result.get('phases', {}).get(phase, {})
        return phase_data.get('reason', 'Unknown failure')
    
    def _print_session_summary(self, session: Dict):
        print(f"\n{'='*60}")
        print("SESSION SUMMARY")
        print(f"{'='*60}")
        print(f"Attempted: {session['transforms_attempted']}")
        print(f"Successful: {session['transforms_successful']}")
        print(f"Failed: {len(session['transforms_failed'])}")
        
        if session['transforms_failed']:
            print("\nFailure breakdown:")
            phase_counts = defaultdict(int)
            for f in session['transforms_failed']:
                phase_counts[self._get_failed_phase({'phases': {f['target']: f}})] += 1
            for phase, count in phase_counts.items():
                print(f"  {phase}: {count}")
        
        print(f"\nFinal system state:")
        print(f"  Functions: {session['final_state']['functions']}")
        print(f"  Avg complexity: {session['final_state']['potential']:.2f}")


