class ExecutionEngine:
    """
    Compiles AST to live code objects and executes in isolated namespace.
    This is the bridge from static analysis to behavioral proof.
    """
    
    def __init__(self):
        self.module_cache: Dict[str, types.ModuleType] = {}
        self.execution_count = 0
        self.failure_log: List[Dict] = []
        
    def ast_to_function(self, func_ast: ast.FunctionDef, 
                       module_name: str = "__legacy_box_runtime__",
                       global_env: Optional[Dict] = None) -> Callable:
        """
        Compile AST node to executable function in real Python runtime.
        """
        # Ensure function has proper line info for tracebacks
        ast.fix_missing_locations(func_ast)
        
        # Create module-level AST
        module_ast = ast.Module(body=[func_ast], type_ignores=[])
        ast.fix_missing_locations(module_ast)
        
        # Compile to code object
        try:
            code = compile(module_ast, filename=f"<{module_name}>", mode="exec")
        except SyntaxError as e:
            raise CompilationError(f"Failed to compile {func_ast.name}: {e}")
        
        # Create isolated namespace with standard library access
        namespace = {
            '__builtins__': __builtins__,
            '__name__': module_name,
            '__file__': f"<{module_name}>",
        }
        
        # Inject dependencies from global_env
        if global_env:
            namespace.update(global_env)
        
        # Execute module code to define function in namespace
        exec(code, namespace)
        
        # Extract the function
        func = namespace.get(func_ast.name)
        if func is None:
            raise RuntimeError(f"Function {func_ast.name} not found in compiled namespace")
        
        # Preserve AST metadata on function
        func.__ast_source__ = func_ast
        func.__compiled_module__ = module_name
        
        return func
    
    def execute_with_capture(self, func: Callable, 
                            args: Tuple = (),
                            kwargs: Optional[Dict] = None,
                            capture_output: bool = True,
                            timeout: float = 5.0) -> Dict[str, Any]:
        """
        Execute function with full isolation and capture.
        Returns complete execution trace including side effects.
        """
        kwargs = kwargs or {}
        result = {
            'success': False,
            'return_value': None,
            'exception': None,
            'stdout': '',
            'stderr': '',
            'execution_time': 0.0,
            'side_effects': []
        }
        
        # Capture I/O streams
        stdout_buffer = io.StringIO() if capture_output else None
        stderr_buffer = io.StringIO() if capture_output else None
        
        start_time = time.perf_counter()
        
        try:
            # Execute with timeout protection (simplified - real impl would use signals/multiprocessing)
            if capture_output:
                with redirect_stdout(stdout_buffer), redirect_stderr(stderr_buffer):
                    result['return_value'] = func(*args, **kwargs)
            else:
                result['return_value'] = func(*args, **kwargs)
                
            result['success'] = True
            
        except Exception as e:
            result['exception'] = {
                'type': type(e).__name__,
                'message': str(e),
                'traceback': traceback.format_exc()
            }
            
        finally:
            result['execution_time'] = time.perf_counter() - start_time
            
            if capture_output:
                result['stdout'] = stdout_buffer.getvalue()
                result['stderr'] = stderr_buffer.getvalue()
        
        self.execution_count += 1
        return result
    
    def compare_executions(self, original_func: Callable, 
                         transformed_func: Callable,
                         test_cases: List[Tuple[Tuple, Dict]],
                         semantic_equiv: Optional[Callable] = None) -> Dict[str, Any]:
        """
        Execute both functions against test suite and compare.
        Returns detailed equivalence report.
        """
        if semantic_equiv is None:
            semantic_equiv = self._default_semantic_equiv
        
        results = {
            'total_cases': len(test_cases),
            'passed': 0,
            'failed': 0,
            'errors': 0,
            'confidence': 0.0,
            'mismatches': [],
            'execution_times': {'original': [], 'transformed': []}
        }
        
        for i, (args, kwargs) in enumerate(test_cases):
            case_id = f"case_{i}"
            
            # Execute original
            orig_result = self.execute_with_capture(original_func, args, kwargs)
            
            # Execute transformed
            trans_result = self.execute_with_capture(transformed_func, args, kwargs)
            
            # Record timing
            if orig_result['success']:
                results['execution_times']['original'].append(orig_result['execution_time'])
            if trans_result['success']:
                results['execution_times']['transformed'].append(trans_result['execution_time'])
            
            # Compare outcomes
            if orig_result['success'] and trans_result['success']:
                # Both succeeded - compare outputs
                if semantic_equiv(orig_result['return_value'], trans_result['return_value']):
                    results['passed'] += 1
                else:
                    results['failed'] += 1
                    results['mismatches'].append({
                        'case': case_id,
                        'args': args,
                        'kwargs': kwargs,
                        'expected': orig_result['return_value'],
                        'actual': trans_result['return_value'],
                        'type': 'value_mismatch'
                    })
                    
            elif not orig_result['success'] and not trans_result['success']:
                # Both failed - compare exceptions
                orig_exc = orig_result['exception']['type'] if orig_result['exception'] else None
                trans_exc = trans_result['exception']['type'] if trans_result['exception'] else None
                
                if orig_exc == trans_exc:
                    results['passed'] += 1  # Exception equivalence
                else:
                    results['failed'] += 1
                    results['mismatches'].append({
                        'case': case_id,
                        'type': 'exception_mismatch',
                        'expected_exc': orig_exc,
                        'actual_exc': trans_exc
                    })
                    
            else:
                # One succeeded, one failed
                results['failed'] += 1
                results['mismatches'].append({
                    'case': case_id,
                    'type': 'success_mismatch',
                    'original_succeeded': orig_result['success'],
                    'transformed_succeeded': trans_result['success']
                })
        
        # Calculate confidence
        if results['total_cases'] > 0:
            results['confidence'] = results['passed'] / results['total_cases']
        
        return results
    
    def _default_semantic_equiv(self, a: Any, b: Any, tolerance: float = 1e-9) -> bool:
        """
        Deep structural equivalence with type-aware comparison.
        """
        if type(a) != type(b):
            # Special cases for numeric types
            if isinstance(a, (int, float)) and isinstance(b, (int, float)):
                return abs(a - b) < tolerance
            return False
        
        if isinstance(a, (int, float, str, bool, type(None))):
            if isinstance(a, float):
                return abs(a - b) < tolerance
            return a == b
        
        if isinstance(a, (list, tuple)):
            if len(a) != len(b):
                return False
            return all(self._default_semantic_equiv(x, y, tolerance) for x, y in zip(a, b))
        
        if isinstance(a, dict):
            if set(a.keys()) != set(b.keys()):
                return False
            return all(self._default_semantic_equiv(a[k], b[k], tolerance) for k in a)
        
        if isinstance(a, set):
            return a == b
        
        # For objects, compare repr or significant attributes
        if hasattr(a, '__dict__') and hasattr(b, '__dict__'):
            return self._default_semantic_equiv(a.__dict__, b.__dict__, tolerance)
        
        # Fallback: string representation
        return repr(a) == repr(b)


