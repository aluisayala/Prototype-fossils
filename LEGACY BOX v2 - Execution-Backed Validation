class SystemScanner:
    def __init__(self):
        self.graph = nx.DiGraph()
        self.modules = {}
        self.functions = {}
        self.classes = {}
        
    def scan_module(self, source_code, module_name):
        try:
            tree = ast.parse(source_code)
            self.modules[module_name] = tree
            
            for node in ast.walk(tree):
                if isinstance(node, ast.FunctionDef):
                    func_id = f"{module_name}.{node.name}"
                    self.functions[func_id] = node
                    self.graph.add_node(func_id, 
                                      type='function',
                                      complexity=self._calc_complexity(node),
                                      lines=getattr(node, 'end_lineno', 0) - node.lineno)
                    
                    # Find calls
                    for child in ast.walk(node):
                        if isinstance(child, ast.Call) and isinstance(child.func, ast.Name):
                            callee = f"{module_name}.{child.func.id}"
                            self.graph.add_edge(func_id, callee, relation='calls')
                            
        except SyntaxError:
            pass
    
    def _calc_complexity(self, node):
        count = 1
        for child in ast.walk(node):
            if isinstance(child, (ast.If, ast.While, ast.For, ast.ExceptHandler)):
                count += 1
            elif isinstance(child, ast.BoolOp):
                count += len(child.values) - 1
        return count


class StabilityClassifier:
    def __init__(self, scanner):
        self.scanner = scanner
        self.history = defaultdict(list)
        
    def calculate_stability(self, node_id):
        G = self.scanner.graph
        centrality = 0
        fan_in = G.in_degree(node_id) if node_id in G else 0
        fan_out = G.out_degree(node_id) if node_id in G else 0
        complexity = G.nodes.get(node_id, {}).get('complexity', 1)
        
        risk = min(0.3 * centrality + 0.2 * fan_in/10 + 0.1 * fan_out/20 + 0.2 * complexity/20 + 0.2 * 0, 1.0)
        
        classification = "LOW_RISK" if risk < 0.4 else "MODERATE" if risk < 0.6 else "HIGH_RISK" if risk < 0.8 else "DO_NOT_TOUCH"
        return {'risk_score': risk, 'classification': classification, 'complexity': complexity, 'fan_in': fan_in, 'fan_out': fan_out}
    
    def record_change(self, node_id, success):
        self.history[node_id].append((time.time(), success))


