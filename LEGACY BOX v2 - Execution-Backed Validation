@dataclass
class ExecutionTrace:
    """Complete execution context for deterministic replay."""
    function_id: str
    inputs: Tuple[Any, ...]
    kwargs: Dict[str, Any]
    output: Any
    exception_type: Optional[str] = None
    timestamp: float = field(default_factory=time.time)
    random_state: Optional[Tuple] = None
    side_effects: List[Dict] = field(default_factory=list)
    execution_time: float = 0.0
    
    def to_signature(self) -> str:
        """Deterministic hash for deduplication."""
        # Normalize for hashing (handle unhashable types)
        try:
            content = f"{self.function_id}:{self.inputs}:{sorted(self.kwargs.items())}"
        except TypeError:
            # Fallback for unhashable kwargs
            content = f"{self.function_id}:{id(self.inputs)}:{id(self.kwargs)}"
        return hashlib.sha256(content.encode()).hexdigest()[:16]


class BehaviorLock:
    """
    Ground truth oracle with real execution capture and replay.
    """
    
    def __init__(self, execution_engine: Optional[ExecutionEngine] = None):
        self.engine = execution_engine or ExecutionEngine()
        self.traces: Dict[str, List[ExecutionTrace]] = defaultdict(list)
        self.signatures: Set[str] = set()
        self._recording = False
        self._determinism_context = {}
        
    def capture_decorator(self, func_id: Optional[str] = None):
        """Decorator to capture real function executions."""
        def decorator(func):
            nonlocal func_id
            fid = func_id or f"{func.__module__}.{func.__name__}"
            
            @functools.wraps(func)
            def wrapper(*args, **kwargs):
                if not self._recording:
                    return func(*args, **kwargs)
                
                # Capture pre-state
                rand_state = random.getstate()
                start_time = time.perf_counter()
                
                # Execute
                try:
                    result = func(*args, **kwargs)
                    exc_type = None
                except Exception as e:
                    result = None
                    exc_type = type(e).__name__
                    raise
                finally:
                    exec_time = time.perf_counter() - start_time
                    
                    trace = ExecutionTrace(
                        function_id=fid,
                        inputs=copy.deepcopy(args),
                        kwargs=copy.deepcopy(kwargs),
                        output=copy.deepcopy(result) if exc_type is None else None,
                        exception_type=exc_type,
                        timestamp=time.time(),
                        random_state=rand_state,
                        execution_time=exec_time
                    )
                    
                    sig = trace.to_signature()
                    if sig not in self.signatures:  # Deduplicate
                        self.traces[fid].append(trace)
                        self.signatures.add(sig)
                
                return result
            
            return wrapper
        return decorator
    
    def get_test_suite(self, func_id: str) -> List[Tuple[Tuple, Dict]]:
        """Extract test cases from captured traces."""
        return [(t.inputs, t.kwargs) for t in self.traces.get(func_id, [])]
    
    def verify_transformation(self, func_id: str,
                             original_func: Callable,
                             transformed_ast: ast.FunctionDef,
                             global_env: Optional[Dict] = None) -> Dict[str, Any]:
        """
        PROVE behavioral equivalence through real execution.
        This is the critical feedback loop.
        """
        test_suite = self.get_test_suite(func_id)
        
        if not test_suite:
            return {
                'verified': False,
                'confidence': 0.0,
                'error': 'No oracle data captured',
                'details': None
            }
        
        # Compile transformed AST to executable
        try:
            transformed_func = self.engine.ast_to_function(
                transformed_ast, 
                module_name=f"__legacy_box_{func_id}__",
                global_env=global_env
            )
        except CompilationError as e:
            return {
                'verified': False,
                'confidence': 0.0,
                'error': f'Compilation failed: {e}',
                'details': None
            }
        
        # Execute comparison
        comparison = self.engine.compare_executions(
            original_func,
            transformed_func,
            test_suite
        )
        
        # Determine verification result
        verified = comparison['confidence'] >= 0.95 and comparison['errors'] == 0
        
        return {
            'verified': verified,
            'confidence': comparison['confidence'],
            'test_cases': comparison['total_cases'],
            'passed': comparison['passed'],
            'failed': comparison['failed'],
            'execution_times': comparison['execution_times'],
            'mismatches': comparison['mismatches'],
            'transformed_func': transformed_func if verified else None,
            'details': comparison
        }
    
    def replay_with_determinism(self, trace: ExecutionTrace, 
                                func: Callable) -> Dict[str, Any]:
        """
        Replay execution with frozen random state for perfect determinism.
        """
        # Restore random state
        if trace.random_state:
            random.setstate(trace.random_state)
        
        # Execute
        result = self.engine.execute_with_capture(
            func,
            trace.inputs,
            trace.kwargs
        )
        
        # Reset random state
        random.seed()
        
        return result


